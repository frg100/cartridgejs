{
  "name": "@cartridgejs/cli",
  "version": "0.1.0",
  "description": "cartridge: build, run and upload three.js / WebGL games to Steam.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "cartridge": "./bin/cartridge.mjs"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"test/*.test.mjs\""
  },
  "dependencies": {
    "@electron/packager": "20.3.0",
    "@cartridgejs/electron": "workspace:*"
  }
}
