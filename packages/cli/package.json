{
  "name": "@cartridgejs/cli",
  "version": "0.1.0",
  "description": "cartridge: build, run and upload three.js / WebGL games to Steam.",
  "license": "MIT",
  "type": "module",
  "bin": { "cartridge": "./dist/bin.js" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
  },
  "files": ["dist", "templates"],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/bin.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"test/*.test.mjs\""
  },
  "dependencies": {
    "@electron/packager": "20.3.0",
    "@cartridgejs/electron": "workspace:*"
  }
}
